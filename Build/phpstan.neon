# The shared config sets level 10, treatPhpDocTypesAsCertain, the
# strictness flags and excludePaths; phpstan/extension-installer registers
# phpstan-typo3, phpat and the other PHPStan extensions.
includes:
    - %currentWorkingDirectory%/.Build/vendor/netresearch/typo3-ci-workflows/config/phpstan/phpstan.neon
    - %currentWorkingDirectory%/Build/phpstan-baseline.neon

parameters:
    paths:
        - %currentWorkingDirectory%/Classes/
        - %currentWorkingDirectory%/Configuration/
        - %currentWorkingDirectory%/Resources/
        - %currentWorkingDirectory%/Tests/
        - %currentWorkingDirectory%/ext_localconf.php

    ignoreErrors:
        -
            identifier: arrayFilter.strict

services:
    -
        class: Netresearch\UniversalMessenger\Tests\Architecture\ArchitectureTest
        tags:
            - phpat.test
